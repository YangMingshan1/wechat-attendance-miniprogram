<!-- 修改签到记录 -->
<view class="record-edit has-fixed-bottom">

  <view class="section-title">可修改项</view>
  <view class="form-group">
    <picker
      mode="selector"
      range="{{courseNames}}"
      value="{{courseIndex}}"
      bindchange="onCourseChange"
    >
      <view class="form-row">
        <view class="k">所属课程</view>
        <view class="v">{{courseNames[courseIndex] || '请选择'}}</view>
        <view class="arrow">›</view>
      </view>
    </picker>

    <view class="form-row">
      <view class="k">学号</view>
      <input
        class="v left"
        placeholder="请输入名单中的学号"
        placeholder-class="ph"
        maxlength="30"
        value="{{form.sno}}"
        data-field="sno"
        bindinput="onInput"
      />
    </view>
    <view class="form-row">
      <view class="k">姓名</view>
      <input
        class="v left"
        placeholder="请输入姓名"
        placeholder-class="ph"
        maxlength="30"
        value="{{form.name}}"
        data-field="name"
        bindinput="onInput"
      />
    </view>
    <view class="form-row">
      <view class="k">班级</view>
      <input
        class="v left"
        placeholder="请输入班级"
        placeholder-class="ph"
        maxlength="50"
        value="{{form.className}}"
        data-field="className"
        bindinput="onInput"
      />
    </view>
  </view>

  <view class="section-title">签到数据（只读，不允许修改）</view>
  <view class="form-group">
    <view class="form-row readonly">
      <view class="k">签到时间</view>
      <view class="v">{{record.signTimeText || '-'}}</view>
    </view>
    <view class="form-row readonly">
      <view class="k">距离</view>
      <view class="v">{{record.distanceText || '-'}}</view>
    </view>
    <view class="form-row readonly">
      <view class="k">经纬度</view>
      <view class="v coord">{{record.coordText || '-'}}</view>
    </view>
    <view class="form-row readonly">
      <view class="k">设备 ID</view>
      <view class="v coord">{{record.deviceIdShort || '-'}}</view>
    </view>
    <view class="form-row readonly" wx:if="{{record.deviceFingerprint}}">
      <view class="k">设备指纹</view>
      <view class="v coord">{{record.deviceFingerprint}}</view>
    </view>
    <view class="form-row readonly" wx:if="{{record.operator || record.updateTimeText}}">
      <view class="k">最后修改</view>
      <view class="v">{{record.updateTimeText || '—'}} {{record.operatorShort ? '· ' + record.operatorShort : ''}}</view>
    </view>
  </view>

  <view class="tip-text">
    说明：课程、学号、姓名、班级可以修改；签到采集数据（时间、距离、经纬度、设备）不可修改，以保证签到事实可追溯。若修改所属课程，系统会重新校验「同课程同设备仅签到 1 次」的约束。
  </view>

  <view class="has-fixed-bottom"></view>
  <view class="fixed-bottom dual">
    <button class="btn plain" bindtap="onDelete">删除记录</button>
    <button class="btn {{saving ? 'disabled' : ''}}" disabled="{{saving}}" bindtap="onSave">
      {{saving ? '保存中…' : '保存修改'}}
    </button>
  </view>

</view>
