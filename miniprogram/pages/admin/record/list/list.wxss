.record-list {
  min-height: 100vh;
  background: var(--bg);
}

/* 筛选条 */
.filters {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #F2F2F2;
}

.filter-item {
  font-size: 25rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  background: #F5F5F5;
  color: #777;
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-item.active {
  background: #E7F5FF;
  color: #0A84C7;
}

.filter-reset {
  font-size: 25rpx;
  color: var(--wx-green);
  margin-left: auto;
}

/* 表头 */
.rec-head {
  display: flex;
  font-size: 23rpx;
  color: #999;
  padding: 18rpx 30rpx 12rpx;
  font-weight: 500;
}

.rec-head .c1 {
  flex: 1;
}

.rec-head .c2 {
  width: 150rpx;
  text-align: center;
}

.rec-head .c3 {
  width: 110rpx;
  text-align: right;
}

/* 记录卡片 */
.rec-item {
  background: #fff;
  margin: 0 30rpx 18rpx;
  border-radius: 18rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.rec-item .r1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rec-item .r1 .nm {
  font-size: 30rpx;
  font-weight: 600;
}

.rec-item .r1 .dist {
  font-size: 23rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: #E8F8EF;
  color: #0A8F4D;
}

.rec-item .r2 {
  font-size: 24rpx;
  color: #8A8A8A;
  margin-top: 12rpx;
  display: flex;
  gap: 24rpx;
}

.rec-item .r2.sub {
  color: #B5B5B5;
  margin-top: 6rpx;
}

.rec-item .r3 {
  display: flex;
  gap: 18rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed #EFEFEF;
}

.mini-btn {
  font-size: 25rpx;
  padding: 8rpx 26rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
  background: #fff;
  color: #444;
}

.mini-btn.red {
  color: var(--danger);
  border-color: #F8D4D4;
}
