.student-list {
  min-height: 100vh;
  background: var(--bg);
}

.searchbar {
  padding: 20rpx 30rpx;
  background: var(--bg);
}

.search-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
}

.search-box .si {
  font-size: 26rpx;
  margin-right: 14rpx;
  color: #B5B5B5;
}

.search-box .sinput {
  flex: 1;
  font-size: 27rpx;
}

.search-box .sclear {
  font-size: 26rpx;
  color: #B5B5B5;
  padding: 0 8rpx;
}

.ph {
  color: #BDBDBD;
}

.list-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6rpx 30rpx 18rpx;
  font-size: 25rpx;
  color: #999;
}

.list-head .import-link {
  color: var(--wx-green);
  font-weight: 500;
}

.stu-row {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #F4F4F4;
}

.stu-row .av {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E8F8EF;
  color: #0A8F4D;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 22rpx;
  flex: 0 0 72rpx;
}

.stu-row .info {
  flex: 1;
  min-width: 0;
}

.stu-row .info .n {
  font-size: 30rpx;
  font-weight: 500;
}

.stu-row .info .s {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.stu-row .del {
  font-size: 26rpx;
  color: var(--danger);
  padding: 8rpx 18rpx;
}

/* 多行提示文本：保留换行 */
.multiline {
  white-space: pre-line;
}
