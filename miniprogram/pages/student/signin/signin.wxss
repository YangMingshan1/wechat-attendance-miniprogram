.signin-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

/* 课程信息卡 */
.cur-course {
  background: #fff;
  margin: 24rpx 30rpx 0;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.cur-course .cc-t {
  font-size: 36rpx;
  font-weight: 600;
}

.cur-course .cc-s {
  font-size: 25rpx;
  color: #8A8A8A;
  margin-top: 12rpx;
}

.cur-course .kv {
  display: flex;
  justify-content: space-between;
  font-size: 25rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed #EFEFEF;
  color: #666;
}

.cur-course .kv .strong {
  font-weight: 600;
  color: #333;
  font-size: 24rpx;
}

/* 定位雷达 */
.radar {
  height: 320rpx;
  background: #fff;
  margin: 22rpx 30rpx 0;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.radar .ring {
  position: absolute;
  width: 172rpx;
  height: 172rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(7, 193, 96, 0.32);
}

.radar .ring.r2 {
  width: 260rpx;
  height: 260rpx;
  border-color: rgba(7, 193, 96, 0.16);
}

.radar .dot {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: var(--wx-green);
  box-shadow: 0 0 0 10rpx rgba(7, 193, 96, 0.2);
  z-index: 2;
}

.radar .dot.pulsing {
  animation: pulse 1.4s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.35);
    opacity: 0.65;
  }
}

.radar .big {
  font-size: 31rpx;
  font-weight: 600;
  color: #333;
  margin-top: 28rpx;
  z-index: 2;
}

.radar .txt {
  font-size: 24rpx;
  color: #8A8A8A;
  margin-top: 10rpx;
  z-index: 2;
}

/* 流程步骤说明 */
.steps {
  margin: 22rpx 30rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.steps .step {
  font-size: 25rpx;
  color: #666;
  line-height: 2;
}

/* 结果面板 */
.result-panel {
  margin: 22rpx 30rpx 0;
  border-radius: 20rpx;
  padding: 44rpx 36rpx;
  text-align: center;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.result-panel .ri {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  color: #fff;
}

.result-panel .rt {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.result-panel .rs {
  font-size: 25rpx;
  color: #7A7A7A;
  line-height: 1.7;
}

.result-panel .detail {
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 16rpx;
  padding: 22rpx 26rpx;
  text-align: left;
}

.result-panel .detail .drow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  line-height: 2;
  color: #555;
}

.result-panel .detail .drow .dv {
  font-weight: 600;
  color: #333;
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-panel .detail .drow .dv.danger {
  color: var(--danger);
}

/* 状态配色 */
.rp-ok {
  background: #E9F9F0;
}

.rp-ok .ri {
  background: var(--wx-green);
}

.rp-err {
  background: #FEF0F0;
}

.rp-err .ri {
  background: var(--danger);
}

.rp-warn {
  background: #FFF7E8;
}

.rp-warn .ri {
  background: var(--warn);
}

.rp-info {
  background: #EDF7FE;
}

.rp-info .ri {
  background: var(--blue);
}

.multiline {
  white-space: pre-line;
}
