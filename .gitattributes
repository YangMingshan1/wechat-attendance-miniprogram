# 统一换行符，避免 Windows / macOS 协作时产生大量无意义的 diff
* text=auto eol=lf

# 二进制文件不做换行转换，也不参与 diff 文本统计
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text eol=lf

# 明确按文本处理
*.js   text eol=lf
*.json text eol=lf
*.wxml text eol=lf
*.wxss text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.mmd  text eol=lf
